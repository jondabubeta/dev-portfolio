---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Jonathan Dabu - Portfolio</title>
  </head>
  <body>
    <header>
      <img src="/images/logo.png" alt="Logo" class="logo" />
      <nav>
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#blog">Blog</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <section class="banner">
      <img src="/images/corgi.png" alt="Corgi Icon" />
      <div>
        <h1>Jonathan Dabu</h1>
        <h2>Software Engineer</h2>
        <p>I specialize in test automation, systems programming, and building intuitive game and web interfaces.</p>
<div class="banner-buttons">
  <a href="#about" class="button-primary">More About Me</a>
  <a href="/JonathanDabu-Resume.pdf" class="button-reverse">Download Resume</a>
</div>
      </div>
    </section>

    <section class="projects" id="projects">
      <h2>PROJECTS</h2>
      <p>Featured work</p>

      <div class="project-tab" onclick="toggleDropdown(this)">
        <div class="project-tab-header">
          <h3><img src="/images/code.png" alt="Code Icon" />Corporate Depths</h3>
          <span class="arrow">►</span>
        </div>
        <div class="project-detail">
          <p>A UI-driven game exploring corporate politics. Built using Godot.</p>
        </div>
      </div>
    </section>

    <script is:inline>
      function toggleDropdown(tab) {
        const isOpen = tab.classList.contains('open');
        document.querySelectorAll('.project-tab').forEach(el => {
          el.classList.remove('open');
          el.querySelector('.arrow').textContent = '►';
        });
        if (!isOpen) {
          tab.classList.add('open');
          tab.querySelector('.arrow').textContent = '▼';
        }
      }
    </script>
  </body>
</html>
